# Gemini (existing app) — set on Vercel for Build + Runtime
GEMINI_API_KEY=your_gemini_api_key

# Standalone access password — set on Vercel for Build (baked into client)
APP_PASSWORD=your_atelier_password

# VisionWorx Gen Tools — Vercel Runtime only (never VITE_* / client bundles)
VWX_KEY_ID=vwxk_paste_the_key_id
VWX_SECRET=vwxs_paste_the_secret
# Hostname only (no https://). Defaults to www.vision-worx.com if unset
VWX_APP_HOST=www.vision-worx.com
